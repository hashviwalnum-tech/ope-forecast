# Supabase project — Dashboard → Settings → API. Both are REQUIRED; the app
# refuses to start without them and shows a "Setup needed" screen instead.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The backend the web app talks to. REQUIRED in production — without it the app
# falls back to http://localhost:8000, which does not exist on a deployed site.
VITE_API_BASE_URL=https://ope-forecast-dj78.onrender.com

# Optional — omit for local dev; set in Vercel environment to enable Sentry
VITE_SENTRY_DSN=
