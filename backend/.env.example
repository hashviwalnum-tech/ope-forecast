DATABASE_URL=sqlite:///./ops_forecast.db
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Required to use PATCH /businesses/me/tier (admin-only tier override for testing).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this in Render environment variables too. Without it the endpoint is always 403.
ADMIN_KEY=your-secret-admin-key-here
# Optional — omit for local dev; set in Render environment to enable Sentry
SENTRY_DSN=
# ── Dev catch-up (testing only — do NOT set in a deployment with real users) ──
# Generates synthetic daily data for one specific account so accuracy evolves
# without manual tapping. Gate 2 (business ID) ensures no other account is touched.
# Find your business ID at GET /businesses (or in the Supabase businesses table).
# DEV_CATCHUP_ENABLED=true
# DEV_TESTING_BUSINESS_ID=1
